PORT=5000
# The website address that may call this backend (comma-separated).
# Local: http://localhost:5173   Cloud VM: https://34-100-229-5.sslip.io
CLIENT_ORIGIN=http://localhost:5173
# Set a long random secret before any public deployment (openssl rand -hex 32).
TOKEN_SECRET=replace-this-with-a-long-random-secret
# Recordings are deleted automatically after this many days (0 = keep forever).
# Also set a matching Cloud Storage lifecycle rule (see README, "Auto-delete").
RECORDING_RETENTION_DAYS=30
# Optional: Google Cloud Storage bucket for recording videos.
# Leave empty to keep recordings on this server's disk.
GCS_BUCKET=
# Optional: Google Cloud SQL (MySQL). Leave DB_HOST empty to use JSON files.
# Create the tables once with backend/db/schema.sql.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=cloudmeet
# Encrypted connection (see db.js):
#  - put Cloud SQL's server-ca.pem in backend/certs/ (checked automatically), or
#  - set DB_SSL_CA=path/to/server-ca.pem, or
#  - set DB_SSL=true (encrypted, certificate not checked)
DB_SSL=
DB_SSL_CA=
