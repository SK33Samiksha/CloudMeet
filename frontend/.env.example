# Leave these EMPTY when using `npm run dev` (HTTPS + proxy).
# The browser then talks to the same address it opened, and Vite forwards
# /api and /socket.io to the backend on this laptop.
VITE_SIGNALING_URL=
VITE_API_URL=

# Where Vite forwards backend requests (the backend runs on the same laptop).
BACKEND_URL=http://localhost:5000

# Optional TURN relay, only if the two laptops cannot connect directly.
# VITE_TURN_URL=turn:your-turn-server:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
